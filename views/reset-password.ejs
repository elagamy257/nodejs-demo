<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <!-- Bootstrap css CDN -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <title>Reset password</title>
</head>
<body class="bg-info my-5 d-flex justify-content-center">
  <div class="w-50 bg-white rounded p-3">
    <h2 class="mb-3">Reset password for <%= email %></h2>
    <form action="" method="post">
      <label class="form-label" for="password">New password</label>
      <input class="form-control" type="password" name="password" id="password" required minlength="8">
      <button class="btn btn-success mt-3" type="submit">Reset Password</button>
    </form>
  </div>
</body>
</html>