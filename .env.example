# Environment Variables Configuration for Vercel / Production
MONGO_URL=mongodb+srv://<username>:<password>@cluster0.mongodb.net/<dbname>?retryWrites=true&w=majority
PORT=5000
NODE_ENV=production
JWT_SECERT_KEY=your_jwt_secret_key_here
USER_EMAIL=your_email@gmail.com
USER_PASS=your_email_app_password
